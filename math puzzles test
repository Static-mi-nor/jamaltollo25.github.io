<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Math Puzzle Challenge</title>
    <style>
        /* CSS Styling */
        :root {
            --primary: #4a90e2;
            --success: #2ecc71;
            --danger: #e74c3c;
            --dark: #2c3e50;
            --light: #ecf0f1;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--light);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            color: var(--dark);
        }

        .game-container {
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            width: 90%;
            max-width: 500px;
            text-align: center;
        }

        h1 {
            margin-top: 0;
            color: var(--primary);
            font-size: 2rem;
        }

        .level-selector {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 20px;
        }

        .level-btn {
            padding: 8px 16px;
            border: 2px solid var(--primary);
            background: transparent;
            color: var(--primary);
            border-radius: 20px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s;
        }

        .level-btn.active, .level-btn:hover {
            background: var(--primary);
            color: white;
        }

        .stats {
            display: flex;
            justify-content: space-between;
            background: #f8f9fa;
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 20px;
            font-weight: bold;
            font-size: 1.1rem;
        }

        .question-box {
            font-size: 2.5rem;
            font-weight: bold;
            margin: 30px 0;
            color: var(--dark);
            min-height: 60px;
        }

        .input-group {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 20px;
        }

        input[type="number"] {
            padding: 12px;
            font-size: 1.2rem;
            border: 2px solid #ccc;
            border-radius: 8px;
            width: 120px;
            text-align: center;
            outline: none;
            transition: border-color 0.3s;
        }

        input[type="number"]:focus {
            border-color: var(--primary);
        }

        .action-btn {
            padding: 12px 24px;
            font-size: 1.1rem;
            font-weight: bold;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            color: white;
            background-color: var(--primary);
            transition: background-color 0.3s, transform 0.1s;
        }

        .action-btn:hover {
            background-color: #357abd;
        }

        .action-btn:active {
            transform: scale(0.95);
        }

        .action-btn:disabled {
            background-color: #bdc3c7;
            cursor: not-allowed;
        }

        .feedback {
            font-size: 1.2rem;
            font-weight: bold;
            height: 30px;
            margin-bottom: 10px;
        }

        .feedback.correct { color: var(--success); }
        .feedback.wrong { color: var(--danger); }

        .next-btn {
            display: none;
            background-color: var(--success);
            margin: 0 auto;
        }

        .next-btn:hover {
            background-color: #27ae60;
        }
    </style>
</head>
<body>

    <div class="game-container">
        <h1>🧮 Math Puzzle Challenge</h1>

        <!-- Level Selection -->
        <div class="level-selector">
            <button class="level-btn active" onclick="setLevel('easy')">Easy</button>
            <button class="level-btn" onclick="setLevel('medium')">Medium</button>
            <button class="level-btn" onclick="setLevel('hard')">Hard</button>
        </div>

        <!-- Score & Streak -->
        <div class="stats">
            <span>Score: <span id="score">0</span></span>
            <span>Streak: <span id="streak">0</span> 🔥</span>
        </div>

        <!-- Question Area -->
        <div class="question-box" id="question">Press Start</div>

        <!-- Input Area -->
        <div class="input-group">
            <input type="number" id="answerInput" placeholder="?" onkeydown="handleKeyPress(event)">
            <button class="action-btn" id="submitBtn" onclick="checkAnswer()">Submit</button>
        </div>

        <!-- Feedback -->
        <div class="feedback" id="feedback"></div>

        <!-- Next Question Button (Hidden initially) -->
        <button class="action-btn next-btn" id="nextBtn" onclick="generateQuestion()">Next Question</button>
    </div>

    <script>
        // Game Variables
        let currentLevel = 'easy';
        let score = 0;
        let streak = 0;
        let correctAnswer = 0;
        let isGameActive = true;

        // DOM Elements
        const questionEl = document.getElementById('question');
        const answerInput = document.getElementById('answerInput');
        const submitBtn = document.getElementById('submitBtn');
        const nextBtn = document.getElementById('nextBtn');
        const feedbackEl = document.getElementById('feedback');
        const scoreEl = document.getElementById('score');
        const streakEl = document.getElementById('streak');
        const levelBtns = document.querySelectorAll('.level-btn');

        // Initialize Game
        window.onload = () => {
            generateQuestion();
        };

        // Set Difficulty Level
        function setLevel(level) {
            currentLevel = level;
            // Update UI for active button
            levelBtns.forEach(btn => {
                btn.classList.remove('active');
                if(btn.innerText.toLowerCase() === level) {
                    btn.classList.add('active');
                }
            });
            // Reset game state for new level
            score = 0;
            streak = 0;
            updateStats();
            generateQuestion();
        }

        // Generate Math Question based on Level
        function generateQuestion() {
            isGameActive = true;
            answerInput.value = '';
            answerInput.disabled = false;
            submitBtn.disabled = false;
            nextBtn.style.display = 'none';
            feedbackEl.innerText = '';
            feedbackEl.className = 'feedback';
            answerInput.focus();

            let num1, num2, operator, questionText;

            if (currentLevel === 'easy') {
                // Easy: Numbers 1-10, Addition & Subtraction
                num1 = Math.floor(Math.random() * 10) + 1;
                num2 = Math.floor(Math.random() * 10) + 1;
                operator = Math.random() > 0.5 ? '+' : '-';
                
                if (operator === '-' && num1 < num2) {
                    // Swap to avoid negative answers
                    [num1, num2] = [num2, num1];
                }
            } else if (currentLevel === 'medium') {
                // Medium: Numbers 1-20, Addition, Subtraction, Multiplication
                num1 = Math.floor(Math.random() * 20) + 1;
                num2 = Math.floor(Math.random() * 20) + 1;
                const ops = ['+', '-', '*'];
                operator = ops[Math.floor(Math.random() * ops.length)];

                if (operator === '-' && num1 < num2) {
                    [num1, num2] = [num2, num1];
                }
            } else {
                // Hard: Numbers 1-50, Mixed operations (including division with integer results)
                const ops = ['+', '-', '*', '/'];
                operator = ops[Math.floor(Math.random() * ops.length)];
                
                if (operator === '+') {
                    num1 = Math.floor(Math.random() * 50) + 1;
                    num2 = Math.floor(Math.random() * 50) + 1;
                } else if (operator === '-') {
                    num1 = Math.floor(Math.random() * 50) + 10;
                    num2 = Math.floor(Math.random() * 50) + 1;
                    if (num1 < num2) [num1, num2] = [num2, num1];
                } else if (operator === '*') {
                    num1 = Math.floor(Math.random() * 12) + 1;
                    num2 = Math.floor(Math.random() * 12) + 1;
                } else if (operator === '/') {
                    num2 = Math.floor(Math.random() * 10) + 1;
                    correctAnswer = Math.floor(Math.random() * 10) + 1;
                    num1 = num2 * correctAnswer; // Ensures whole number division
                }
            }

            // Calculate correct answer
            if (operator === '+') correctAnswer = num1 + num2;
            else if (operator === '-') correctAnswer = num1 - num2;
            else if (operator === '*') correctAnswer = num1 * num2;
            else if (operator === '/') correctAnswer = num1 / num2;

            // Display Question
            const displayOp = operator === '*' ? '×' : (operator === '/' ? '÷' : operator);
            questionText = `${num1} ${displayOp} ${num2} = ?`;
            questionEl.innerText = questionText;
        }

        // Check the user's answer
        function checkAnswer() {
            if (!isGameActive) return;

            const userAnswer = parseFloat(answerInput.value);

            if (isNaN(userAnswer)) {
                feedbackEl.innerText = "Please enter a number!";
                feedbackEl.className = "feedback wrong";
                return;
            }

            if (userAnswer === correctAnswer) {
                // Correct Answer
                score += 10;
                streak += 1;
                feedbackEl.innerText = "Correct! 🎉";
                feedbackEl.className = "feedback correct";
                
                // Bonus points for streaks
                if (streak >= 3) {
                    score += 5; 
                    feedbackEl.innerText += " (Streak Bonus +5)";
                }
            } else {
                // Wrong Answer
                score = Math.max(0, score - 5); // Deduct points, but don't go below 0
                streak = 0;
                feedbackEl.innerText = `Wrong. The answer was ${correctAnswer}.`;
                feedbackEl.className = "feedback wrong";
            }

            // Update UI
            updateStats();
            isGameActive = false;
            answerInput.disabled = true;
            submitBtn.disabled = true;
            nextBtn.style.display = 'block';
            nextBtn.focus();
        }

        // Update Score and Streak display
        function updateStats() {
            scoreEl.innerText = score;
            streakEl.innerText = streak;
        }

        // Allow pressing "Enter" to submit
        function handleKeyPress(event) {
            if (event.key === 'Enter') {
                if (isGameActive) {
                    checkAnswer();
                } else {
                    generateQuestion();
                }
            }
        }
    </script>
</body>
</html>